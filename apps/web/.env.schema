# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Host of the production deployment, without protocol. Vercel sets it; local development leaves it empty.
# @public @optional
VERCEL_PROJECT_PRODUCTION_URL=

# Absolute address of this site, for the URLs that crawlers fetch.
# @public @type=url
SITE_ORIGIN=if(isEmpty($VERCEL_PROJECT_PRODUCTION_URL), http://localhost:3001, concat(https://, $VERCEL_PROJECT_PRODUCTION_URL))
