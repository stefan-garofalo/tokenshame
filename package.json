{
  "name": "tokenshame",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "effect": "4.1.2",
      "@effect/platform-node": "4.1.2",
      "tsdown": "0.23.5",
      "@types/node": "^26.4.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "check": "oxlint && oxfmt --write",
    "dev:cli": "turbo run dev -F tokenshame --",
    "lint": "node \".agents/scripts/managed-lint-runner.mjs\"",
    "prepare": "node .agents/scripts/activate-git-hooks.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tokenshame/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "1.90.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
